// ─── Sidebar ─────────────────────────────────────────────────────────────────
//
// Plugin-based left sidebar. Click a row header to expand/collapse its panel.
// Drag the ⠿ handle to reorder plugins (only available when all are collapsed).
// Drag the bottom edge of an expanded panel to resize it vertically.

export struct PluginItem {
    id:           string,
    title:        string,
    subtitle:     string,
    icon:         string,
    plugin-index: int,   // -1 for built-ins; index into [[plugins]] for external
}

export struct WorkspaceProject {
    code:       string,
    color:      color,
    text-color: color,
}

export struct PriorityProject {
    name:  string,
    code:  string,
    color: color,
}

// ─── Command button ───────────────────────────────────────────────────────────

component CmdButton inherits Rectangle {
    in property <string> label;
    callback command(string);

    height: 32px;
    border-radius: 4px;
    background: ta.has-hover ? #ffffff1C : #ffffff0E;

    ta := TouchArea {
        width: parent.width; height: parent.height;
        clicked => { root.command(root.label); }
    }
    Text {
        text: root.label;
        color: rgba(255, 255, 255, 0.72);
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        width: parent.width; height: parent.height;
    }
}

// ─── Tasku expanded panel ─────────────────────────────────────────────────────
//
// Height is set from outside (Sidebar.tasku-panel-h). The terminal rectangle
// fills whatever space remains after the button grid. The bottom 8px is a
// drag handle that fires resize-start / resize-move / resize-end callbacks.

component TaskuContent inherits Rectangle {
    in property <image> terminal-image;
    in property <color> theme-terminal-area-bg: #020617;
    callback command(string);
    callback key-input(string, bool, bool);  // text, ctrl, meta
    callback resize-start();
    callback resize-move(float);   // delta-y in logical px from press point
    callback resize-end();
    callback scroll(float);        // scroll-wheel delta-y in logical px

    // Stored in screen coordinates so the computation stays correct even if
    // the Flickable scrolls or the panel height changes mid-drag.
    private property <float> press-abs-y: 0;

    background: transparent;

    // ── Keyboard focus scope ──────────────────────────────────────────────────
    fs := FocusScope {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height - 8px;

        key-pressed(e) => {
            root.key-input(e.text, e.modifiers.control, e.modifiers.meta);
            accept
        }
    }

    // btn-w: each button is exactly 1/3 of the inner width.
    // Inner width = panel width minus 8px left + 8px right padding = root.width - 16px.
    // Two 4px gaps between 3 columns consume 8px → btn-w = (root.width - 24px) / 3.
    private property <length> btn-w: (root.width - 24px) / 3;
    private property <length> btn-gap: 4px;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 8px;
        spacing: 6px;

        // ── Button grid (4 rows × 3 buttons, explicit widths) ─────────────────
        VerticalLayout {
            width: parent.width;
            spacing: 4px;

            Rectangle { width: parent.width; height: 32px;
                CmdButton { x: 0;                              width: root.btn-w; label: "Add";     command(l) => { root.command(l); } }
                CmdButton { x: root.btn-w + root.btn-gap;      width: root.btn-w; label: "List";    command(l) => { root.command(l); } }
                CmdButton { x: 2*(root.btn-w + root.btn-gap);  width: root.btn-w; label: "Stats";   command(l) => { root.command(l); } }
            }
            Rectangle { width: parent.width; height: 32px;
                CmdButton { x: 0;                              width: root.btn-w; label: "Edit";    command(l) => { root.command(l); } }
                CmdButton { x: root.btn-w + root.btn-gap;      width: root.btn-w; label: "Delete";  command(l) => { root.command(l); } }
                CmdButton { x: 2*(root.btn-w + root.btn-gap);  width: root.btn-w; label: "SQL";     command(l) => { root.command(l); } }
            }
            Rectangle { width: parent.width; height: 32px;
                CmdButton { x: 0;                              width: root.btn-w; label: "Today";   command(l) => { root.command(l); } }
                CmdButton { x: root.btn-w + root.btn-gap;      width: root.btn-w; label: "Tmrw";    command(l) => { root.command(l); } }
                CmdButton { x: 2*(root.btn-w + root.btn-gap);  width: root.btn-w; label: "Overdue"; command(l) => { root.command(l); } }
            }
            Rectangle { width: parent.width; height: 32px;
                CmdButton { x: 0;                              width: root.btn-w; label: "Todo";    command(l) => { root.command(l); } }
                CmdButton { x: root.btn-w + root.btn-gap;      width: root.btn-w; label: "Started"; command(l) => { root.command(l); } }
                CmdButton { x: 2*(root.btn-w + root.btn-gap);  width: root.btn-w; label: "Done";    command(l) => { root.command(l); } }
            }
        }

        // ── Terminal (fills remaining height after button grid) ───────────────
        terminal-rect := Rectangle {
            width: parent.width;
            vertical-stretch: 1;
            background: root.theme-terminal-area-bg;
            border-radius: 4px;
            clip: true;

            if root.terminal-image.width > 0: Image {
                x: 8px;
                width: parent.width - 8px; height: parent.height;
                source: root.terminal-image;
                image-fit: fill;
            }
            if root.terminal-image.width == 0: Text {
                text: "starting…";
                color: rgba(255, 255, 255, 0.12);
                font-size: 11px;
                horizontal-alignment: center; vertical-alignment: center;
                width: parent.width; height: parent.height;
            }

            // Click to focus; scroll-wheel forwarded to the PTY
            TouchArea {
                width: parent.width; height: parent.height;
                mouse-cursor: MouseCursor.text;
                clicked => { fs.focus(); }
                scroll-event(e) => {
                    root.scroll(e.delta-y / 1px);
                    accept
                }
            }
        }
    }

    // ── Resize drag handle (absolutely positioned at the panel bottom) ─────────
    resize-strip := Rectangle {
        x: 0;
        y: parent.height - 8px;
        width: parent.width;
        height: 8px;
        background: transparent;

        resize-ta := TouchArea {
            width: parent.width; height: parent.height;
            mouse-cursor: MouseCursor.ns-resize;

            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.press-abs-y =
                        self.absolute-position.y / 1px + self.mouse-y / 1px;
                    root.resize-start();
                } else if (e.kind == PointerEventKind.up
                        || e.kind == PointerEventKind.cancel) {
                    root.resize-end();
                }
            }
            moved => {
                if (self.pressed) {
                    root.resize-move(
                        self.absolute-position.y / 1px + self.mouse-y / 1px
                        - root.press-abs-y
                    );
                }
            }
        }

        // Subtle drag-pip indicator
        Rectangle {
            x: parent.width / 2 - 20px;
            y: 3px;
            width: 40px; height: 2px;
            border-radius: 1px;
            background: resize-ta.has-hover
                ? rgba(255, 255, 255, 0.35)
                : rgba(255, 255, 255, 0.09);
        }
    }
}

// ─── Workspaces expanded panel ────────────────────────────────────────────────
//
// Renders project tiles 3-per-row. Each tile is a square coloured with the
// project's brand colour; the 3-letter code is centred inside with a
// luminance-appropriate text colour (set by Rust at fetch time).

component WorkspacesContent inherits Rectangle {
    in property <[WorkspaceProject]> projects;
    in property <string>            active-project;
    callback workspace-selected(string);

    background: transparent;
    clip: true;

    // Tile geometry derived from available width
    private property <length> pad:    8px;
    private property <length> gap:    6px;
    // 3 columns, 2 inter-column gaps, left+right padding
    private property <length> tile-w: (root.width - 2 * root.pad - 2 * root.gap) / 3;

    for proj[i] in root.projects: Rectangle {
        x: root.pad + mod(i, 3) * (root.tile-w + root.gap);
        y: root.pad + floor(i / 3) * (root.tile-w + root.gap);
        width:  root.tile-w;
        height: root.tile-w;   // square
        border-radius: 8px;
        background: proj.color;

        // ── Content: indicator dot + code label ───────────────────────────────
        VerticalLayout {
            alignment: center;
            spacing: 5px;
            width: parent.width; height: parent.height;

            // Active indicator — circle centred above the code.
            // Always occupies space so all tiles have identical layout;
            // invisible when this project is not the active workspace.
            HorizontalLayout {
                alignment: center;
                height: 8px;
                Rectangle {
                    width: 8px; height: 8px;
                    border-radius: 4px;
                    background: proj.text-color;
                    opacity: proj.code == root.active-project ? 1.0 : 0.0;
                }
            }

            Text {
                text: proj.code;
                color: proj.text-color;
                font-size: 13px;
                font-weight: 700;
                letter-spacing: 0.5px;
                horizontal-alignment: center;
            }
        }

        // Click target — on top of content
        TouchArea {
            width: parent.width; height: parent.height;
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.workspace-selected(proj.code); }
        }
    }

    // Empty-state label when Tasku has no projects yet
    if root.projects.length == 0: Text {
        text: "no projects";
        color: rgba(255, 255, 255, 0.18);
        font-size: 11px;
        horizontal-alignment: center; vertical-alignment: center;
        width: parent.width; height: parent.height;
    }
}

// ─── Priority row ─────────────────────────────────────────────────────────────
//
// One draggable row in the Priorities panel. The ⠿ handle on the left initiates
// a drag; the outer PrioritiesContent tracks drag-y and computes drop-index.

component PriorityRow inherits Rectangle {
    in property <PriorityProject> proj;
    in property <int>   row-index;
    in property <float> item-h: 36;
    in property <bool>  is-dragging: false;
    in property <bool>  show-drop-indicator: false;
    in property <color> theme-focus-border: #7aa2f7;

    callback drag-start(int, float);  // (row-index, initial-y)
    callback drag-move(float);        // updated y
    callback drag-end();

    private property <float> press-y: 0;
    height: root.item-h * 1px;

    // Drop-before indicator line
    if root.show-drop-indicator: Rectangle {
        x: 0; y: 0; height: 2px; width: parent.width;
        background: root.theme-focus-border;
    }

    Rectangle {
        x: 0;
        y: root.show-drop-indicator ? 2px : 0;
        width: parent.width;
        height: root.show-drop-indicator ? root.item-h * 1px - 2px : root.item-h * 1px;
        background: root.is-dragging ? #ffffff08 : transparent;
        opacity: root.is-dragging ? 0.4 : 1.0;

        HorizontalLayout {
            padding: 0;
            padding-right: 8px;
            spacing: 0;
            width: parent.width;
            height: parent.height;

            // ── Drag handle ───────────────────────────────────────────────────
            Rectangle {
                width: 32px;
                height: parent.height;

                drag-ta := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: MouseCursor.move;

                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            root.press-y = self.mouse-y / 1px;
                            root.drag-start(root.row-index, root.row-index * root.item-h);
                        } else if (e.kind == PointerEventKind.up
                                || e.kind == PointerEventKind.cancel) {
                            root.drag-end();
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            root.drag-move(
                                root.row-index * root.item-h
                                + (self.mouse-y / 1px - root.press-y)
                            );
                        }
                    }
                }

                Text {
                    text: "⠿";
                    color: drag-ta.has-hover
                        ? rgba(255, 255, 255, 0.55)
                        : rgba(255, 255, 255, 0.12);
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }

            // ── Project colour dot ────────────────────────────────────────────
            Rectangle {
                width: 22px;
                height: parent.height;

                Rectangle {
                    width: 10px; height: 10px;
                    border-radius: 5px;
                    background: root.proj.color;
                    x: 6px;
                    y: parent.height / 2 - 5px;
                }
            }

            // ── Project name ──────────────────────────────────────────────────
            Text {
                text: root.proj.name;
                color: rgba(255, 255, 255, 0.75);
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
                height: parent.height;
            }
        }
    }
}

// ─── Priorities expanded panel ────────────────────────────────────────────────
//
// Scrollable list of PriorityRow items ordered highest → lowest priority.
// Drag-to-reorder works identically to the plugin panel reorder.

component PrioritiesContent inherits Rectangle {
    in property <[PriorityProject]> projects;
    in property <color> theme-focus-border: #7aa2f7;
    callback reordered(int, int);  // (from-index, to-index)

    private property <int>   drag-index: -1;
    private property <float> drag-y:     0;
    private property <float> item-h:     36;

    private property <int> drop-index: {
        if (root.drag-index < 0) { -1 }
        else { clamp(round(root.drag-y / root.item-h), 0, root.projects.length) }
    }

    background: transparent;
    clip: true;

    Flickable {
        x: 0; y: 0;
        width: parent.width - 1px;
        height: parent.height;
        viewport-height: root.projects.length * root.item-h * 1px + 8px;

        VerticalLayout {
            width: parent.width;
            alignment: start;
            padding-top: 4px;
            padding-bottom: 4px;

            for proj[i] in root.projects: PriorityRow {
                width: parent.width;
                proj: proj;
                row-index: i;
                item-h: root.item-h;
                theme-focus-border: root.theme-focus-border;
                is-dragging: root.drag-index == i;
                show-drop-indicator:
                    root.drag-index >= 0
                    && root.drop-index == i
                    && root.drop-index != root.drag-index
                    && root.drop-index != root.drag-index + 1;

                drag-start(idx, y) => { root.drag-index = idx; root.drag-y = y; }
                drag-move(y)       => { root.drag-y = y; }
                drag-end           => {
                    if (root.drag-index >= 0
                        && root.drop-index >= 0
                        && root.drop-index != root.drag-index
                        && root.drop-index != root.drag-index + 1) {
                        root.reordered(root.drag-index, root.drop-index);
                    }
                    root.drag-index = -1;
                }
            }

            // Drop indicator after the last item
            if root.drag-index >= 0 && root.drop-index == root.projects.length: Rectangle {
                height: 2px;
                background: root.theme-focus-border;
            }
        }
    }

    if root.projects.length == 0: Text {
        text: "no projects";
        color: rgba(255, 255, 255, 0.18);
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
}

// ─── External plugin terminal panel ──────────────────────────────────────────
//
// A plain resizable terminal for any external plugin binary.
// Resize by dragging the pip at the bottom.

component PluginContent inherits Rectangle {
    in property <image> terminal-image;
    in property <bool>  is-pixel: false;   // true = pixel plugin, renders full-bleed
    callback resize-start();
    callback resize-move(float);   // cumulative delta-y from press point (logical px)
    callback resize-end();
    callback key-input(string, bool, bool);  // text, ctrl, meta
    callback scroll(float);                  // scroll-wheel delta-y in logical px
    callback click(float, float);            // x, y in logical px
    callback focus-changed(bool);            // true = gained, false = lost

    private property <float> press-abs-y: 0;
    background: transparent;

    public function take-focus() { fs.focus(); }

    // ── Keyboard focus scope ──────────────────────────────────────────────────
    fs := FocusScope {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height - 8px;

        key-pressed(e) => {
            root.key-input(e.text, e.modifiers.control, e.modifiers.meta);
            accept
        }
        changed has-focus => {
            if (root.is-pixel) { root.focus-changed(self.has-focus); }
        }
    }

    // ── Terminal display ──────────────────────────────────────────────────────
    if !root.is-pixel: Rectangle {
        x: 8px; y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        background: #080A12;
        border-radius: 4px;
        clip: true;

        if root.terminal-image.width > 0: Image {
            x: 8px;
            width: parent.width - 8px; height: parent.height;
            source: root.terminal-image;
            image-fit: fill;
        }
        if root.terminal-image.width == 0: Text {
            text: "starting…";
            color: rgba(255, 255, 255, 0.12);
            font-size: 11px;
            horizontal-alignment: center; vertical-alignment: center;
            width: parent.width; height: parent.height;
        }

        // Click to focus; scroll-wheel forwarded to the PTY
        TouchArea {
            width: parent.width; height: parent.height;
            mouse-cursor: MouseCursor.text;
            clicked => { fs.focus(); }
            scroll-event(e) => {
                root.scroll(e.delta-y / 1px);
                accept
            }
        }
    }

    // ── Pixel plugin display (full-bleed, no terminal chrome) ─────────────────
    if root.is-pixel: Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height - 8px;
        clip: true;

        if root.terminal-image.width > 0: Image {
            x: 0; y: 0;
            width: parent.width;
            height: parent.height;
            source: root.terminal-image;
            image-fit: fill;
        }

        TouchArea {
            width: parent.width; height: parent.height;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) { root.take-focus(); }
            }
            clicked => { root.click(self.mouse-x / 1px, self.mouse-y / 1px); }
            scroll-event(e) => {
                root.scroll(e.delta-y / 1px);
                accept
            }
        }
    }

    // ── Resize handle (bottom 8px) ────────────────────────────────────────────
    resize-strip := Rectangle {
        x: 0;
        y: parent.height - 8px;
        width: parent.width;
        height: 8px;
        background: transparent;

        resize-ta := TouchArea {
            width: parent.width; height: parent.height;
            mouse-cursor: MouseCursor.ns-resize;

            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.press-abs-y =
                        self.absolute-position.y / 1px + self.mouse-y / 1px;
                    root.resize-start();
                } else if (e.kind == PointerEventKind.up
                        || e.kind == PointerEventKind.cancel) {
                    root.resize-end();
                }
            }
            moved => {
                if (self.pressed) {
                    root.resize-move(
                        self.absolute-position.y / 1px + self.mouse-y / 1px
                        - root.press-abs-y
                    );
                }
            }
        }

        Rectangle {
            x: parent.width / 2 - 20px;
            y: 3px;
            width: 40px; height: 2px;
            border-radius: 1px;
            background: resize-ta.has-hover
                ? rgba(255, 255, 255, 0.35)
                : rgba(255, 255, 255, 0.09);
        }
    }
}

// ─── Plugin row header ────────────────────────────────────────────────────────

component PluginRowHeader inherits Rectangle {
    in property <PluginItem> item;
    in property <int>    row-index;
    in property <float>  row-h: 52;
    in property <bool>   is-dragging: false;
    in property <bool>   show-drop-indicator: false;
    in property <bool>   show-drag-handle: true;
    in property <bool>   expanded: false;
    in property <color>  theme-focus-border: #7aa2f7;

    callback toggled();
    callback drag-start(int, float);  // (row-index, initial-sidebar-y)
    callback drag-move(float);        // updated sidebar-y
    callback drag-end();

    private property <float> press-y: 0;
    height: root.row-h * 1px;

    // Drop-before indicator line
    if root.show-drop-indicator: Rectangle {
        x: 0; y: 0; height: 2px; width: parent.width;
        background: root.theme-focus-border;
    }

    // Row background
    Rectangle {
        x: 0;
        y: root.show-drop-indicator ? 2px : 0px;
        width: parent.width;
        height: root.show-drop-indicator ? root.row-h * 1px - 2px : root.row-h * 1px;
        background: root.is-dragging ? #ffffff08 : transparent;
        opacity: root.is-dragging ? 0.4 : 1.0;

        HorizontalLayout {
            padding: 0; spacing: 0;

            // ── Drag handle (32px) ────────────────────────────────────────────
            Rectangle {
                width: 32px; height: parent.height;

                drag-ta := TouchArea {
                    width: parent.width; height: root.row-h * 1px;
                    enabled: root.show-drag-handle;
                    mouse-cursor: root.show-drag-handle ? MouseCursor.move : MouseCursor.default;

                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            root.press-y = self.mouse-y / 1px;
                            root.drag-start(root.row-index, root.row-index * root.row-h);
                        } else if (e.kind == PointerEventKind.up
                                || e.kind == PointerEventKind.cancel) {
                            root.drag-end();
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            root.drag-move(
                                root.row-index * root.row-h
                                + (self.mouse-y / 1px - root.press-y)
                            );
                        }
                    }
                }

                Text {
                    text: "≡";
                    color: !root.show-drag-handle ? rgba(255,255,255,0.0)
                         : drag-ta.has-hover      ? rgba(255,255,255,0.55)
                         :                          rgba(255,255,255,0.12);
                    font-family: "SF Pro Text";
                    font-size: 14px;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: parent.width; height: parent.height;
                }
            }

            // ── Icon ──────────────────────────────────────────────────────────
            Rectangle {
                width: 38px; height: parent.height;
                Text {
                    text: root.item.icon;
                    color: rgba(255,255,255,0.45);
                    font-family: "Hack Nerd Font";
                    font-size: 22px;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: parent.width; height: parent.height;
                }
            }

            // ── Title (click to expand/collapse) ─────────────────────────────
            body-ta := TouchArea {
                horizontal-stretch: 1;
                height: root.row-h * 1px;
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.toggled(); }

                Text {
                    text: root.item.title;
                    color: rgba(255,255,255,0.80);
                    font-family: "SF Pro Text";
                    font-size: 18px; font-weight: 700;
                    letter-spacing: 0.4px;
                    overflow: elide;
                    vertical-alignment: center;
                    padding-left: 18px; padding-right: 4px;
                    width: parent.width; height: parent.height;
                }
            }

            // ── Expand chevron ────────────────────────────────────────────────
            Rectangle {
                width: 24px; height: parent.height;
                Text {
                    text: root.expanded ? "↓" : "›";
                    color: rgba(255,255,255,0.22);
                    font-family: "SF Pro Text";
                    font-size: 12px;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: parent.width; height: parent.height;
                }
            }
        }
    }
}

// ─── Sidebar ──────────────────────────────────────────────────────────────────

export component Sidebar inherits Rectangle {
    in property <color> theme-window-bg:        #0f172a;
    in property <color> theme-terminal-area-bg: #020617;
    in property <color> theme-card-bg:          #1e293b;
    in property <color> theme-card-border:      #334155;
    in property <color> theme-focus-border:     #7aa2f7;

    background: root.theme-window-bg;

    in-out property <[PluginItem]> plugins;
    in property <image> tasku-terminal-image;
    in property <[WorkspaceProject]> ws-projects;
    in property <string> active-project;
    in property <[PriorityProject]> priority-projects;

    // ── External plugin data (parallel arrays, one entry per [[plugins]] item) ─
    in property <[image]>  plugin-images;
    in property <[bool]>   plugin-pixel;   // true = pixel protocol, false = PTY terminal
    in-out property <[bool]>  plugin-expanded;
    in-out property <[float]> plugin-panel-h;
    // True when any external plugin panel is open (drives drag-lock like built-ins).
    in property <bool> plugin-any-expanded: false;
    // Sum of open external plugin panel heights, in logical px. Rust keeps this
    // updated so total-content-h stays correct without a fold in Slint.
    in property <float> external-plugins-total-h: 0;

    callback plugin-reordered(int, int);            // from-index, to-index
    callback tasku-toggled(bool);                   // true = expanded
    callback tasku-command(string);                 // button label → CLI command
    callback tasku-key-input(string, bool, bool);   // text, ctrl, meta
    callback tasku-panel-height-changed(float);     // notifies Rust to resize PTY
    callback tasku-scroll(float);                   // scroll-wheel delta-y on terminal
    callback workspace-selected(string);            // project code clicked
    callback priority-reordered(int, int);          // priority drag-to-reorder
    callback plugin-toggled(int);                   // plugin-index toggled (Rust updates plugin-expanded)
    callback plugin-panel-height-changed(int, float); // plugin-index, new height
    callback plugin-key-input(int, string, bool, bool); // plugin-index, text, ctrl, meta
    callback plugin-scroll(int, float);             // plugin-index, scroll delta-y
    callback plugin-click(int, float, float);       // plugin-index, x, y
    callback plugin-focus-changed(int, bool);       // plugin-index, focused

    // ── Drag state ────────────────────────────────────────────────────────────
    private property <int>   drag-index: -1;
    private property <float> drag-y: 0;
    private property <float> row-h: 52;

    // ── Per-built-in expanded state ───────────────────────────────────────────
    private property <bool> tasku-expanded:      false;
    private property <bool> workspaces-expanded: false;
    private property <bool> priorities-expanded: false;

    // True when at least one panel (built-in or external) is open.
    private property <bool> any-expanded:
        root.tasku-expanded || root.workspaces-expanded || root.priorities-expanded
        || root.plugin-any-expanded;

    // ── Tasku panel resize state ──────────────────────────────────────────────
    private property <length> tasku-panel-h: 400px;
    private property <length> tasku-press-h: 0px;

    // ── External plugin resize tracking ──────────────────────────────────────
    // Only one plugin can be resized at a time; track which one and its press height.
    private property <int>   plugin-resize-index: -1;
    private property <float> plugin-resize-press-h: 0;

    // ── Workspaces panel height ───────────────────────────────────────────────
    private property <length> ws-tile-w: (root.width - 28px) / 3;
    private property <float>  ws-rows:   floor((root.ws-projects.length + 2) / 3);
    private property <length> ws-panel-h:
        root.ws-projects.length == 0
        ? 60px
        : 16px + root.ws-rows * root.ws-tile-w + max(root.ws-rows - 1, 0) * 6px;

    // ── Priorities panel height ───────────────────────────────────────────────
    private property <float>  prio-count: root.priority-projects.length;
    private property <length> prio-panel-h:
        root.prio-count == 0
        ? 60px
        : clamp(root.prio-count * 36px + 8px, 60px, 300px);

    // Drop-before index during plugin reorder drag.
    private property <int> drop-index: {
        if (root.drag-index < 0) { -1 }
        else { clamp(round(root.drag-y / root.row-h), 0, root.plugins.length) }
    }

    // Total viewport height: sum of all row headers + all expanded panel heights.
    private property <length> total-content-h:
        root.plugins.length * root.row-h * 1px
        + (root.tasku-expanded      ? root.tasku-panel-h  : 0px)
        + (root.workspaces-expanded ? root.ws-panel-h     : 0px)
        + (root.priorities-expanded ? root.prio-panel-h   : 0px)
        + root.external-plugins-total-h * 1px
        + 16px                                             // 8px top + 8px bottom padding
        + max(root.plugins.length - 1, 0) * 6px;          // 6px gap between cards

    // ── Flickable plugin list ─────────────────────────────────────────────────
    flickable := Flickable {
        x: 0; y: 0;
        width: parent.width - 1px;
        height: parent.height;
        viewport-height: root.total-content-h;

        VerticalLayout {
            width: parent.width;
            alignment: start;
            spacing: 6px;
            padding: 8px;

            for item[i] in root.plugins: Rectangle {
                width: parent.width - 16px;  // 8px padding each side
                border-radius: 6px;
                background: root.theme-card-bg;
                border-width: 1px;
                border-color: root.theme-card-border;
                clip: true;
                height: root.row-h * 1px
                    + (item.id == "tasku"      && root.tasku-expanded      ? root.tasku-panel-h : 0px)
                    + (item.id == "workspaces" && root.workspaces-expanded ? root.ws-panel-h    : 0px)
                    + (item.id == "priorities" && root.priorities-expanded ? root.prio-panel-h  : 0px)
                    + (item.plugin-index >= 0  && root.plugin-expanded[item.plugin-index]
                       ? root.plugin-panel-h[item.plugin-index] * 1px : 0px);

                VerticalLayout {
                width: parent.width;
                spacing: 0;

                PluginRowHeader {
                    width: parent.width;
                    item: item;
                    row-index: i;
                    row-h: root.row-h;
                    theme-focus-border: root.theme-focus-border;
                    expanded: item.id == "tasku"       ? root.tasku-expanded      :
                              item.id == "workspaces"  ? root.workspaces-expanded :
                              item.id == "priorities"  ? root.priorities-expanded :
                              item.plugin-index >= 0   ? root.plugin-expanded[item.plugin-index] : false;
                    is-dragging: root.drag-index == i;
                    show-drag-handle: !root.any-expanded;
                    show-drop-indicator:
                        root.drag-index >= 0
                        && root.drop-index == i
                        && root.drop-index != root.drag-index
                        && root.drop-index != root.drag-index + 1;

                    toggled => {
                        if (item.id == "tasku") {
                            if (root.tasku-expanded) {
                                root.tasku-expanded = false;
                                root.tasku-toggled(false);
                            } else {
                                root.tasku-expanded = true;
                                root.tasku-toggled(true);
                            }
                        }
                        if (item.id == "workspaces") {
                            root.workspaces-expanded = root.workspaces-expanded ? false : true;
                        }
                        if (item.id == "priorities") {
                            root.priorities-expanded = root.priorities-expanded ? false : true;
                        }
                        if (item.plugin-index >= 0) {
                            root.plugin-toggled(item.plugin-index);
                        }
                    }
                    drag-start(idx, y) => { root.drag-index = idx; root.drag-y = y; }
                    drag-move(y)       => { root.drag-y = y; }
                    drag-end           => {
                        if (root.drag-index >= 0
                            && root.drop-index >= 0
                            && root.drop-index != root.drag-index
                            && root.drop-index != root.drag-index + 1) {
                            root.plugin-reordered(root.drag-index, root.drop-index);
                        }
                        root.drag-index = -1;
                    }
                }

                // ── Per-plugin expanded content ───────────────────────────────

                if item.id == "tasku" && root.tasku-expanded: TaskuContent {
                    width: parent.width;
                    height: root.tasku-panel-h;
                    terminal-image: root.tasku-terminal-image;
                    theme-terminal-area-bg: root.theme-terminal-area-bg;
                    command(cmd) => { root.tasku-command(cmd); }
                    key-input(text, ctrl, meta) => { root.tasku-key-input(text, ctrl, meta); }
                    scroll(delta) => { root.tasku-scroll(delta); }
                    resize-start => {
                        root.tasku-press-h = root.tasku-panel-h;
                    }
                    resize-move(delta) => {
                        root.tasku-panel-h = clamp(
                            root.tasku-press-h + delta * 1px,
                            180px,
                            1400px
                        );
                        root.tasku-panel-height-changed(root.tasku-panel-h / 1px);
                    }
                    resize-end => { }
                }

                if item.id == "workspaces" && root.workspaces-expanded: WorkspacesContent {
                    width: parent.width;
                    height: root.ws-panel-h;
                    projects: root.ws-projects;
                    active-project: root.active-project;
                    workspace-selected(code) => { root.workspace-selected(code); }
                }

                if item.id == "priorities" && root.priorities-expanded: PrioritiesContent {
                    width: parent.width;
                    height: root.prio-panel-h;
                    projects: root.priority-projects;
                    theme-focus-border: root.theme-focus-border;
                    reordered(from, to) => { root.priority-reordered(from, to); }
                }

                if item.plugin-index >= 0 && root.plugin-expanded[item.plugin-index]: PluginContent {
                    width: parent.width;
                    height: root.plugin-panel-h[item.plugin-index] * 1px;
                    terminal-image: root.plugin-images[item.plugin-index];
                    is-pixel: root.plugin-pixel[item.plugin-index];
                    key-input(text, ctrl, meta) => {
                        root.plugin-key-input(item.plugin-index, text, ctrl, meta);
                    }
                    scroll(delta) => { root.plugin-scroll(item.plugin-index, delta); }
                    click(x, y) => { root.plugin-click(item.plugin-index, x, y); }
                    focus-changed(focused) => { root.plugin-focus-changed(item.plugin-index, focused); }
                    resize-start => {
                        root.plugin-resize-index   = item.plugin-index;
                        root.plugin-resize-press-h = root.plugin-panel-h[item.plugin-index];
                    }
                    resize-move(delta) => {
                        root.plugin-panel-height-changed(
                            item.plugin-index,
                            clamp(root.plugin-resize-press-h + delta, 100, 1400)
                        );
                    }
                    resize-end => {
                        root.plugin-resize-index = -1;
                    }
                }
                }  // end inner VerticalLayout
            }  // end card Rectangle

            // Drop indicator after the last item
            if root.drag-index >= 0 && root.drop-index == root.plugins.length: Rectangle {
                height: 2px; background: root.theme-focus-border;
            }
        }
    }

    // Right-edge separator
    Rectangle {
        x: parent.width - 1px; y: 0;
        width: 1px; height: parent.height;
        background: root.theme-card-border;
    }
}
