export component PaneView inherits Rectangle {
    in property <color> pane-color;
    in property <int> pane-id;
    in property <bool> is-closable;
    in property <image> terminal-image;
    in property <bool> is-focused: false;
    in property <bool> force-focus: false;

    // Theme colours — set by MainWindow from the loaded theme.
    in property <color> theme-pane-bg:      #0f172a;
    in property <color> theme-pane-toolbar: #1e293b;
    in property <color> theme-focus-border: #7aa2f7;
    in property <color> theme-active-dot:   #22c55e;

    callback split-horizontal();
    callback split-vertical();
    callback close();
    callback toggle-left-sidebar();
    callback toggle-right-sidebar();
    callback toggle-top-bar();
    callback toggle-bottom-bar();
    callback toggle-help();
    in property <bool> help-visible: false;
    // Incremented by MainWindow when a sidebar/overlay releases focus back to panes.
    // Avoids the Rust set_force_focus_id round-trip which Slint can batch away.
    in property <int> refocus-counter: 0;
    // text, ctrl, meta(Cmd), alt(Opt), shift
    callback key-input(string, bool, bool, bool, bool);
    callback request-focus(int);
    callback zoom-in();
    callback zoom-out();
    callback zoom-reset();
    callback scroll(float);
    // Directional pane focus (triggered by keyboard shortcut)
    callback focus-neighbor(int);  // 0=left 1=right 2=up 3=down
    // Selection / clipboard
    callback mouse-pressed(float, float);
    callback mouse-moved(float, float);
    callback mouse-released();

    background: root.theme-pane-bg;

    // Grab keyboard focus when this pane is first rendered (components are
    // created lazily so init fires after the window is visible).
    init => {
        if (root.is-focused) {
            scope.focus();
        }
    }

    // When Rust sets is-focused = true, give the FocusScope actual keyboard focus.
    // This handles both the initial pane and any programmatic focus changes.
    changed is-focused => {
        if (root.is-focused) {
            scope.focus();
        }
    }
    changed force-focus => {
        if (root.force-focus) {
            scope.focus();
        }
    }
    // Pure-Slint path: when the sidebar releases focus back to panes, this
    // counter increments on the focused pane so scope.focus() fires without
    // needing a Rust round-trip (which Slint may batch and lose).
    changed refocus-counter => {
        if (root.is-focused) {
            scope.focus();
        }
    }

    // Keyboard handler — active when this pane is focused
    scope := FocusScope {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;

        key-pressed(e) => {
            // ── Help overlay: swallow all keys when visible ───────────────
            if (root.help-visible) {
                if (e.text == "\u{001B}" || ((e.modifiers.meta || e.modifiers.control) && e.text == "/")) {
                    root.toggle-help();
                }
                return accept;
            }
            // ── Pane management shortcuts ─────────────────────────────────
            // Accept either meta (Cmd) or control as the command modifier —
            // some setups swap Cmd↔Ctrl at the OS level. Checking text=="d"
            // (not "\u{0004}") safely excludes a real terminal Ctrl+D (EOF).
            if ((e.modifiers.meta || e.modifiers.control) && !e.modifiers.alt) {
                // Cmd+D — split right (vertical divider)
                if (e.text == "d") { root.split-vertical(); return accept; }
                // Cmd+Shift+D — split down (horizontal divider)
                if (e.text == "D") { root.split-horizontal(); return accept; }
                // Cmd+W — close pane
                if (e.text == "w") { root.close(); return accept; }
                // Cmd+[ / Cmd+] — toggle left / right sidebar
                if (e.text == "[") { root.toggle-left-sidebar(); return accept; }
                if (e.text == "]") { root.toggle-right-sidebar(); return accept; }
                // Cmd+T / Cmd+B — toggle top / bottom bar
                if (e.text == "t") { root.toggle-top-bar(); return accept; }
                if (e.text == "b") { root.toggle-bottom-bar(); return accept; }
                // Cmd+/ — toggle help overlay
                if (e.text == "/") { root.toggle-help(); return accept; }
            }
            // Cmd+Opt+Arrows — focus neighbour pane (arrows are unambiguous)
            // hjkl variants included but may produce Opt-modified chars on macOS
            if ((e.modifiers.meta || e.modifiers.control) && e.modifiers.alt) {
                if (e.text == "h" || e.text == "\u{F702}") { root.focus-neighbor(0); return accept; }
                if (e.text == "l" || e.text == "\u{F703}") { root.focus-neighbor(1); return accept; }
                if (e.text == "k" || e.text == "\u{F700}") { root.focus-neighbor(2); return accept; }
                if (e.text == "j" || e.text == "\u{F701}") { root.focus-neighbor(3); return accept; }
            }
            // Pass everything else through to Rust for zoom / terminal forwarding.
            root.key-input(e.text, e.modifiers.control, e.modifiers.meta, e.modifiers.alt, e.modifiers.shift);
            accept
        }
    }

    // Click to focus + drag to select.
    click-area := TouchArea {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                scope.focus();
                root.request-focus(root.pane-id);
                root.mouse-pressed(self.mouse-x / 1px, self.mouse-y / 1px);
            } else if (e.kind == PointerEventKind.up) {
                root.mouse-released();
            }
        }
        moved => {
            if (self.pressed) {
                root.mouse-moved(self.mouse-x / 1px, self.mouse-y / 1px);
            }
        }
        scroll-event(e) => {
            root.scroll(e.delta-y / 1px);
            accept
        }
    }

    // Terminal image — sits below the toolbar with 5px margins.
    // Size matches what Rust renders: (width - 10px) × (height - 33px).
    if root.terminal-image.width > 0: Image {
        x: 20px;
        y: 28px;
        width: parent.width - 40px;
        height: parent.height - 28px;
        source: root.terminal-image;
        image-fit: fill;
    }

    // Focus border
    if root.is-focused: Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        border-width: 1px;
        border-color: root.theme-focus-border;
        background: transparent;  // intentional: border only, terminal visible behind
    }

    // Toolbar strip — flush with pane edges.
    toolbar := Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 28px;
        background: root.is-focused ? root.theme-pane-toolbar : transparent;

        HorizontalLayout {
            spacing: 2px;
            padding-left: 8px;
            padding-right: 6px;
            padding-top: 4px;
            padding-bottom: 4px;

            // Active pane indicator — green when focused, dim gray when not
            Text {
                text: "●";
                color: root.is-focused ? root.theme-active-dot : #3a3a4a;
                font-family: "Hack Nerd Font";
                font-size: 18px;
                vertical-alignment: center;
                width: 22px;
            }

            // Spacer — pushes buttons to the right
            Rectangle { horizontal-stretch: 1; }

            // Split / close buttons — only on the focused pane
            if root.is-focused: h-area := TouchArea {
                width: 22px;
                height: 20px;
                clicked => { root.split-horizontal(); }

                Rectangle {
                    width: 22px;
                    height: 20px;
                    border-radius: 3px;
                    background: h-area.has-hover ? #ffffff30 : #ffffff18;

                    Text {
                        text: "⇔";
                        color: #aaaaaa;
                        font-family: "Hack Nerd Font";
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            if root.is-focused: v-area := TouchArea {
                width: 22px;
                height: 20px;
                clicked => { root.split-vertical(); }

                Rectangle {
                    width: 22px;
                    height: 20px;
                    border-radius: 3px;
                    background: v-area.has-hover ? #ffffff30 : #ffffff18;

                    Text {
                        text: "⇕";
                        color: #aaaaaa;
                        font-family: "Hack Nerd Font";
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Close
            if root.is-focused && root.is-closable: close-area := TouchArea {
                width: 22px;
                height: 20px;
                clicked => { root.close(); }

                Rectangle {
                    width: 22px;
                    height: 20px;
                    border-radius: 3px;
                    background: close-area.has-hover ? #ff444430 : #ffffff18;

                    Text {
                        text: "✕";
                        color: close-area.has-hover ? #ff6666 : #aaaaaa;
                        font-family: "Hack Nerd Font";
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
