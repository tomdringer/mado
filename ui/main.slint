import { PaneView }     from "pane_view.slint";
import { DividerHandle } from "divider_handle.slint";
import { Sidebar, PluginItem, WorkspaceProject, PriorityProject, TaskuContent } from "sidebar.slint";
import { TopBar } from "top_bar.slint";
import { BottomBar, RunnerContent } from "bottom_bar.slint";
import { HelpOverlay } from "help_overlay.slint";

export struct FlatPane {
    id: int,
    x: float,
    y: float,
    width: float,
    height: float,
    bg-color: color,
    is-closable: bool,
    terminal-image: image,
    is-focused: bool,
}

export struct FlatDivider {
    split-id: int,
    is-vertical: bool,
    x: float,
    y: float,
    width: float,
    height: float,
    active: bool,
}

export component MainWindow inherits Window {
    title: "Mado";
    preferred-width: 1200px;
    preferred-height: 800px;
    background: transparent;

    // ── Terminal pane data ────────────────────────────────────────────────────
    in property <[FlatPane]>    panes;
    in property <[FlatDivider]> dividers;

    // ── Divider drag cursor state ─────────────────────────────────────────────
    in property <bool> near-h-div: false;
    in property <bool> near-v-div: false;
    in property <bool> is-dragging: false;

    // ── Sidebar ───────────────────────────────────────────────────────────────
    in-out property <[PluginItem]> plugins;
    in-out property <float> sidebar-width: 300;
    in property <image> tasku-terminal-image;
    /// "ok" | "not-installed" | "outdated"
    in property <string> tasku-status: "ok";
    in property <[WorkspaceProject]> ws-projects;
    in-out property <string> active-project;
    in property <int> force-focus-id: -1;
    in property <[PriorityProject]> priority-projects;

    // ── External plugin parallel arrays (left sidebar) ────────────────────────
    in property <[image]>     plugin-images;
    in property <[bool]>      plugin-pixel;
    in-out property <[bool]>  plugin-expanded;
    in-out property <[float]> plugin-panel-h;
    in property <bool>        plugin-any-expanded: false;
    in property <float>       external-plugins-total-h: 0;

    // ── Top bar ───────────────────────────────────────────────────────────────
    in-out property <float> top-bar-height: 200;
    in-out property <bool> show-top-bar: false;
    // AI panel — toggled by the button in the top bar
    in-out property <bool> show-ai-panel: false;
    in-out property <[PluginItem]> top-plugins;
    in property <[image]> top-plugin-images;
    in property <[bool]>  top-plugin-pixel;

    // ── Right sidebar ─────────────────────────────────────────────────────────
    in-out property <float> right-sidebar-width: 300;
    in-out property <bool> show-right-sidebar: false;
    in-out property <[PluginItem]> right-plugins;
    in property <[image]> right-plugin-images;
    in property <[bool]>  right-plugin-pixel;
    in-out property <[bool]>  right-plugin-expanded;
    in-out property <[float]> right-plugin-panel-h;
    in property <bool>  right-plugin-any-expanded: false;
    in property <float> right-external-plugins-total-h: 0;

    // ── Top bar expanded state ────────────────────────────────────────────────
    in-out property <bool> top-bar-expanded: false;

    // ── Top-right panel plugin ────────────────────────────────────────────────
    in property <image>  top-right-plugin-image;
    in property <string> top-right-plugin-icon: "";
    in property <string> top-right-plugin-title: "";
    in-out property <float> top-right-panel-width: 0;
    callback top-right-plugin-key-input(string, bool, bool, bool, bool); // text, ctrl, meta, alt, shift
    callback top-right-plugin-scroll(float);
    callback top-right-plugin-mouse-press(float, float);
    callback top-right-plugin-mouse-move(float, float);
    callback top-right-plugin-mouse-release();
    callback top-right-panel-width-changed(float);
    private property <float> top-right-press-abs-x: 0;
    private property <float> top-right-press-width: 0;
    private property <bool>  top-right-is-resizing: false;

    // ── Browser panel (native WKWebView overlay) ──────────────────────────────
    in-out property <float> browser-panel-width: 0;
    in-out property <bool> show-browser-panel: false;
    // Fired when show-browser-panel toggles — Rust uses this to show/hide the WKWebView.
    callback browser-visible-changed(bool);
    callback browser-panel-width-changed(float);
    // Exposes the browser panel's left edge in logical window coords so Rust can
    // position the native WKWebView to match the Slint layout exactly.
    out property <float> browser-panel-logical-x:
        root.show-browser-panel && root.browser-panel-width > 0
        ? (root.effective-sidebar-w + (terminal-area.width / 1px) + 1.0)
        : 0.0;
    private property <float> browser-press-abs-x: 0;
    private property <float> browser-press-width: 0;
    private property <bool>  browser-is-resizing: false;

    // ── Bottom-right panel plugin ─────────────────────────────────────────────
    in property <image>  bottom-right-plugin-image;
    in property <string> bottom-right-plugin-icon: "";
    in property <string> bottom-right-plugin-title: "";
    in-out property <float> bottom-right-panel-width: 0;
    callback bottom-right-plugin-key-input(string, bool, bool, bool, bool); // text, ctrl, meta, alt, shift
    callback bottom-right-plugin-scroll(float);

    // ── Bottom bar (task runner) ──────────────────────────────────────────────
    in-out property <bool>  show-bottom-bar: false;
    in-out property <bool>   bottom-bar-expanded: false;
    in-out property <length> runner-panel-h: 300px;
    in property <image> runner-terminal-image;
    in property <string> runner-current-command: "";
    in property <bool>  runner-is-running: false;
    callback runner-panel-height-changed(float);
    callback runner-restart();
    callback runner-mouse-pressed(float, float);
    callback runner-mouse-moved(float, float);
    callback runner-mouse-released();

    // ── Plugin float overlay ──────────────────────────────────────────────────
    in property <image> float-plugin-image;
    callback plugin-float(int);        // left sidebar plugin-index
    callback right-plugin-float(int);  // right sidebar plugin-index
    callback plugin-float-dismissed();

    // Runner drag state (private)
    private property <float> runner-press-abs-y: 0.0;
    private property <length> runner-press-h: 300px;

    // ── Theme colours (set by Rust at startup from the loaded theme) ──────────
    in property <color> theme-window-bg:        #0f172a;
    in property <color> theme-terminal-area-bg: #020617;
    in property <color> theme-pane-bg:          #0f172a;
    in property <color> theme-pane-toolbar:     #1e293b;
    in property <color> theme-focus-border:     #7aa2f7;
    in property <color> theme-active-dot:       #22c55e;
    in property <color> theme-card-bg:          #1e293b;
    in property <color> theme-card-border:      #334155;
    in property <color> theme-divider-active:   #8888cc;
    in property <color> theme-divider-inactive: #3a3a55;
    in property <color> theme-text-primary:     #f1f5f9;
    in property <color> theme-text-muted:       #64748b;

    // ── Terminal area dimensions exposed to Rust ──────────────────────────────
    out property <float> window-w: terminal-area.width  / 1px;
    out property <float> window-h: terminal-area.height / 1px;
    // Bottom bar logical height (52 when shown, 0 otherwise) — used by Rust to
    // compute the native browser WKWebView y offset in NSView coordinates.
    out property <float> bottom-bar-logical-h: root.effective-bottom-bar-h / 1px;

    // ── Callbacks ─────────────────────────────────────────────────────────────
    callback overlay-press(float, float);
    callback overlay-move(float, float);
    callback overlay-release();
    callback overlay-hover(float, float);
    callback split-pane(int, bool);
    callback close-pane(int);
    callback window-resized(float, float);
    callback pane-key-input(int, string, bool, bool, bool, bool); // id, text, ctrl, meta, alt, shift
    callback pane-focus-request(int);
    callback pane-focus-neighbor(int, int);  // pane-id, direction (0=L 1=R 2=U 3=D)
    callback pane-scroll(int, float);
    callback pane-mouse-pressed(int, float, float);
    callback pane-mouse-moved(int, float, float);
    callback pane-mouse-released(int);
    callback zoom-in();
    callback zoom-out();
    callback zoom-reset();
    callback plugin-reordered(int, int);
    callback sidebar-width-changed(float);
    callback tasku-toggled(bool);
    callback tasku-command(string);
    callback tasku-key-input(string, bool, bool, bool, bool); // text, ctrl, meta, alt, shift
    callback tasku-mouse-press(float, float);
    callback tasku-mouse-move(float, float);
    callback tasku-mouse-release();
    callback tasku-panel-height-changed(float);
    callback tasku-scroll(float);
    callback workspace-selected(string);
    callback workspace-refresh();
    callback priority-reordered(int, int);
    callback plugin-toggled(int);
    callback plugin-panel-height-changed(int, float);
    callback plugin-key-input(int, string, bool, bool, bool, bool); // idx, text, ctrl, meta, alt, shift
    callback plugin-scroll(int, float);
    callback plugin-click(int, float, float);
    callback plugin-focus-changed(int, bool);

    // Bottom bar / runner callbacks
    callback runner-play();
    callback runner-stop();
    callback runner-key-input(string, bool, bool, bool, bool); // text, ctrl, meta, alt, shift
    callback runner-scroll(float);

    // Top bar callbacks
    callback top-bar-height-changed(float);
    callback top-plugin-key-input(int, string, bool, bool, bool, bool); // idx, text, ctrl, meta, alt, shift
    callback top-plugin-scroll(int, float);
    callback top-plugin-click(int, float, float);
    callback top-plugin-focus-changed(int, bool);

    // Right sidebar callbacks
    callback right-sidebar-width-changed(float);
    callback right-plugin-toggled(int);
    callback right-plugin-panel-height-changed(int, float);
    callback right-plugin-key-input(int, string, bool, bool, bool, bool); // idx, text, ctrl, meta, alt, shift
    callback right-plugin-scroll(int, float);
    callback right-plugin-click(int, float, float);
    callback right-plugin-focus-changed(int, bool);

    changed window-w => { root.window-resized(root.window-w, root.window-h); }
    changed window-h => { root.window-resized(root.window-w, root.window-h); }
    changed show-browser-panel => { root.browser-visible-changed(root.show-browser-panel); }

    // Top bar shows when explicitly enabled OR when the AI/browser panel is configured.
    private property <bool>   show-top-bar-effective: root.show-top-bar || root.top-right-panel-width > 0 || root.browser-panel-width > 0;
    // Top bar is always 52px (header only). Content shown via overlay below.
    private property <length> effective-top-bar-h: root.show-top-bar-effective ? 52px : 0px;
    // Bottom bar is always 52px (header only). Content shown via overlay above.
    private property <length> effective-bottom-bar-h: root.show-bottom-bar ? 52px : 0px;

    callback sidebar-escaped();

    // ── Help overlay ──────────────────────────────────────────────────────────
    private property <bool> show-help: false;

    // ── Pane refocus counter — incremented when a sidebar/overlay yields focus ──
    // Slint can batch the Rust set_force_focus_id(fid)/set_force_focus_id(-1)
    // pair so changed force-focus never fires with true. This counter fires
    // entirely inside Slint, guaranteeing scope.focus() is called.
    private property <int> pane-refocus-counter: 0;

    // ── Icon-only sidebar state ───────────────────────────────────────────────
    private property <bool>  sidebar-icon-only: false;
    private property <bool>  right-sidebar-icon-only: false;
    private property <int>   left-sb-kb-counter: 0;
    private property <int>   right-sb-kb-counter: 0;
    private property <float> effective-sidebar-w:
        root.sidebar-icon-only ? 52.0 : root.sidebar-width;
    private property <float> effective-right-w:
        root.right-sidebar-icon-only ? 52.0 : root.right-sidebar-width;

    // Full window width — used by Rust for overlay PTY sizing.
    out property <float> overlay-total-w: root.width / 1px;

    // ── Sidebar resize state ──────────────────────────────────────────────────
    private property <bool>  sidebar-is-resizing: false;
    private property <float> resize-press-abs-x: 0;
    private property <float> resize-press-width: 0;

    // ── Right sidebar resize state ────────────────────────────────────────────
    private property <bool>  right-sidebar-is-resizing: false;
    private property <float> right-resize-press-abs-x: 0;
    private property <float> right-resize-press-width: 0;

    // ── Layout ────────────────────────────────────────────────────────────────
    VerticalLayout {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        spacing: 0;
        padding: 0;

        // ── Top bar header (always 52px; content rendered in overlay below) ─────
        if root.show-top-bar-effective: TopBar {
            width: parent.width;
            height: 52px;
            expanded: root.top-bar-expanded;
            top-plugins: root.top-plugins;
            theme-card-bg: root.theme-card-bg;
            theme-card-border: root.theme-card-border;
            show-ai-button: root.top-right-panel-width > 0;
            ai-active: root.show-ai-panel;
            ai-toggled => { root.show-ai-panel = !root.show-ai-panel; }
            show-browser-button: root.browser-panel-width > 0;
            browser-active: root.show-browser-panel;
            browser-toggled => { root.show-browser-panel = !root.show-browser-panel; }
            expanded-changed(exp) => { root.top-bar-expanded = exp; }
        }

        // ── Main area: sidebars + terminal ────────────────────────────────────
        HorizontalLayout {
            spacing: 0;
            padding: 0;

            // ── Left sidebar ──────────────────────────────────────────────────
            Sidebar {
                width: root.effective-sidebar-w * 1px;
                icon-only: root.sidebar-icon-only;
                icon-only-toggled => { root.sidebar-icon-only = !root.sidebar-icon-only; }
                kb-focus-count: root.left-sb-kb-counter;
                focus-escaped => {
                    root.pane-refocus-counter = root.pane-refocus-counter + 1;
                    root.sidebar-escaped();
                }
                focus-collapsed => {
                    root.sidebar-icon-only = true;
                    root.pane-refocus-counter = root.pane-refocus-counter + 1;
                    root.sidebar-escaped();
                }
                plugins: root.plugins;
                tasku-terminal-image: root.tasku-terminal-image;
                tasku-status: root.tasku-status;
                ws-projects: root.ws-projects;
                active-project: root.active-project;
                priority-projects: root.priority-projects;
                plugin-images: root.plugin-images;
                plugin-pixel: root.plugin-pixel;
                plugin-expanded: root.plugin-expanded;
                plugin-panel-h: root.plugin-panel-h;
                plugin-any-expanded: root.plugin-any-expanded;
                external-plugins-total-h: root.external-plugins-total-h;
                theme-window-bg: root.theme-window-bg;
                theme-terminal-area-bg: root.theme-terminal-area-bg;
                theme-card-bg: root.theme-card-bg;
                theme-card-border: root.theme-card-border;
                theme-focus-border: root.theme-focus-border;
                plugin-reordered(from, to) => { root.plugin-reordered(from, to); }
                tasku-toggled(expanded) => { root.tasku-toggled(expanded); }
                tasku-command(cmd) => { root.tasku-command(cmd); }
                tasku-key-input(text, ctrl, meta, alt, shift) => { root.tasku-key-input(text, ctrl, meta, alt, shift); }
                tasku-panel-height-changed(h) => { root.tasku-panel-height-changed(h); }
                tasku-scroll(delta) => { root.tasku-scroll(delta); }
                workspace-selected(code) => { root.workspace-selected(code); }
                workspace-refresh => { root.workspace-refresh(); }
                priority-reordered(from, to) => { root.priority-reordered(from, to); }
                plugin-toggled(idx) => { root.plugin-toggled(idx); }
                plugin-panel-height-changed(idx, h) => { root.plugin-panel-height-changed(idx, h); }
                plugin-key-input(idx, text, ctrl, meta, alt, shift) => {
                    root.plugin-key-input(idx, text, ctrl, meta, alt, shift);
                }
                plugin-scroll(idx, delta) => { root.plugin-scroll(idx, delta); }
                plugin-click(idx, x, y) => { root.plugin-click(idx, x, y); }
                plugin-focus-changed(idx, focused) => { root.plugin-focus-changed(idx, focused); }
                plugin-float(idx) => { root.plugin-float(idx); }
            }

            // ── Terminal area ─────────────────────────────────────────────────
            terminal-area := Rectangle {
                background: transparent;

                overlay := TouchArea {
                    x: 0; y: 0;
                    width: parent.width;
                    height: parent.height;

                    mouse-cursor: root.is-dragging
                        ? (root.near-v-div ? MouseCursor.ns-resize : MouseCursor.ew-resize)
                        : (root.near-v-div ? MouseCursor.ns-resize
                           : root.near-h-div ? MouseCursor.ew-resize
                           : MouseCursor.default);

                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            root.overlay-press(self.mouse-x / 1px, self.mouse-y / 1px);
                        } else if (e.kind == PointerEventKind.up
                                || e.kind == PointerEventKind.cancel) {
                            root.overlay-release();
                        }
                    }

                    moved => {
                        if (self.pressed) {
                            root.overlay-move(self.mouse-x / 1px, self.mouse-y / 1px);
                        } else {
                            root.overlay-hover(self.mouse-x / 1px, self.mouse-y / 1px);
                        }
                    }
                }

                for pane in root.panes: PaneView {
                    x: pane.x * 1px;
                    y: pane.y * 1px;
                    width: pane.width * 1px;
                    height: pane.height * 1px;
                    pane-color: pane.bg-color;
                    pane-id: pane.id;
                    is-closable: pane.is-closable;
                    terminal-image: pane.terminal-image;
                    is-focused: pane.is-focused;
                    theme-pane-bg: root.theme-pane-bg;
                    theme-pane-toolbar: root.theme-pane-toolbar;
                    theme-focus-border: root.theme-focus-border;
                    theme-active-dot: root.theme-active-dot;
                    split-horizontal      => { root.split-pane(pane.id, true); }
                    split-vertical        => { root.split-pane(pane.id, false); }
                    close                 => { root.close-pane(pane.id); }
                    toggle-left-sidebar   => {
                        root.sidebar-icon-only = false;
                        root.left-sb-kb-counter = root.left-sb-kb-counter + 1;
                    }
                    toggle-right-sidebar  => {
                        root.right-sidebar-icon-only = false;
                        root.right-sb-kb-counter = root.right-sb-kb-counter + 1;
                    }
                    toggle-top-bar        => {
                        root.show-top-bar = !root.show-top-bar;
                        if (root.show-top-bar) { root.top-bar-expanded = true; }
                    }
                    toggle-bottom-bar     => {
                        root.show-bottom-bar = !root.show-bottom-bar;
                        if (root.show-bottom-bar) { root.bottom-bar-expanded = true; }
                    }
                    toggle-help => { root.show-help = !root.show-help; }
                    help-visible: root.show-help;
                    // Only the currently-focused pane sees counter increments.
                    refocus-counter: pane.is-focused ? root.pane-refocus-counter : 0;
                    force-focus: pane.id == root.force-focus-id;
                    key-input(text, ctrl, meta, alt, shift) => { root.pane-key-input(pane.id, text, ctrl, meta, alt, shift); }
                    request-focus(id) => { root.pane-focus-request(id); }
                    scroll(delta) => { root.pane-scroll(pane.id, delta); }
                    mouse-pressed(x, y) => { root.pane-mouse-pressed(pane.id, x, y); }
                    mouse-moved(x, y)   => { root.pane-mouse-moved(pane.id, x, y); }
                    mouse-released()    => { root.pane-mouse-released(pane.id); }
                    zoom-in    => { root.zoom-in(); }
                    zoom-out   => { root.zoom-out(); }
                    zoom-reset => { root.zoom-reset(); }
                    focus-neighbor(dir) => { root.pane-focus-neighbor(pane.id, dir); }
                }

                for div in root.dividers: DividerHandle {
                    x: div.x * 1px;
                    y: div.y * 1px;
                    width: div.width * 1px;
                    height: div.height * 1px;
                    is-vertical: div.is-vertical;
                    active: div.active;
                    theme-divider-active: root.theme-divider-active;
                    theme-divider-inactive: root.theme-divider-inactive;
                }
            }

            // ── Persistent browser panel (native WKWebView overlay) ──────────
            // The actual content is a native WKWebView added by Rust as an NSView
            // subview directly on the Slint NSView.  These Slint Rectangles exist
            // only to reserve space in the HorizontalLayout so the terminal area
            // shrinks correctly, and to provide the left-edge divider line.
            if root.show-browser-panel && root.browser-panel-width > 0: Rectangle {
                width: 1px;
                background: root.theme-card-border;
            }
            if root.show-browser-panel && root.browser-panel-width > 0: Rectangle {
                width: root.browser-panel-width * 1px;
                background: root.theme-terminal-area-bg;
            }

            // ── Persistent AI panel (toggled via top-bar button) ─────────────
            if root.show-ai-panel && root.top-right-panel-width > 0: Rectangle {
                width: 1px;
                background: root.theme-card-border;
            }
            if root.show-ai-panel && root.top-right-panel-width > 0: Rectangle {
                width: root.top-right-panel-width * 1px;
                background: root.theme-terminal-area-bg;
                clip: true;

                // FocusScope covers the full panel (no header — toggle is in top bar)
                ai-fs := FocusScope {
                    x: 0px; y: 0px;
                    width: parent.width; height: parent.height;
                    key-pressed(e) => {
                        root.top-right-plugin-key-input(e.text, e.modifiers.control, e.modifiers.meta, e.modifiers.alt, e.modifiers.shift);
                        accept
                    }
                }

                if root.top-right-plugin-image.width > 0: Image {
                    x: 0px; y: 0px;
                    width: parent.width; height: parent.height;
                    source: root.top-right-plugin-image;
                    image-fit: fill;
                }
                if root.top-right-plugin-image.width == 0: Text {
                    text: "starting…";
                    color: rgba(255, 255, 255, 0.12);
                    font-size: 11px;
                    horizontal-alignment: center; vertical-alignment: center;
                    x: 0px; y: 0px;
                    width: parent.width; height: parent.height;
                }

                TouchArea {
                    x: 0px; y: 0px;
                    width: parent.width; height: parent.height;
                    mouse-cursor: MouseCursor.text;
                    clicked => { ai-fs.focus(); }
                    pointer-event(e) => {
                        ai-fs.focus();
                        if e.kind == PointerEventKind.down {
                            root.top-right-plugin-mouse-press(self.mouse-x / 1px, self.mouse-y / 1px);
                        } else if e.kind == PointerEventKind.up {
                            root.top-right-plugin-mouse-release();
                        }
                    }
                    moved => {
                        root.top-right-plugin-mouse-move(self.mouse-x / 1px, self.mouse-y / 1px);
                    }
                    scroll-event(e) => {
                        root.top-right-plugin-scroll(e.delta-y / 1px);
                        accept
                    }
                }
            }

            // ── Right sidebar left-edge separator ─────────────────────────────
            if root.show-right-sidebar: Rectangle {
                width: 1px;
                background: root.theme-card-border;
            }

            // ── Right sidebar (optional) ─────────────────────────────────────
            if root.show-right-sidebar: Sidebar {
                width: root.effective-right-w * 1px;
                icon-only: root.right-sidebar-icon-only;
                right-align: true;
                icon-only-toggled => { root.right-sidebar-icon-only = !root.right-sidebar-icon-only; }
                kb-focus-count: root.right-sb-kb-counter;
                focus-escaped => {
                    root.pane-refocus-counter = root.pane-refocus-counter + 1;
                    root.sidebar-escaped();
                }
                focus-collapsed => {
                    root.right-sidebar-icon-only = true;
                    root.pane-refocus-counter = root.pane-refocus-counter + 1;
                    root.sidebar-escaped();
                }
                plugins: root.right-plugins;
                tasku-terminal-image: root.tasku-terminal-image;
                tasku-status: root.tasku-status;
                ws-projects: root.ws-projects;
                active-project: root.active-project;
                priority-projects: root.priority-projects;
                plugin-images: root.right-plugin-images;
                plugin-pixel: root.right-plugin-pixel;
                plugin-expanded: root.right-plugin-expanded;
                plugin-panel-h: root.right-plugin-panel-h;
                plugin-any-expanded: root.right-plugin-any-expanded;
                external-plugins-total-h: root.right-external-plugins-total-h;
                theme-window-bg: root.theme-window-bg;
                theme-terminal-area-bg: root.theme-terminal-area-bg;
                theme-card-bg: root.theme-card-bg;
                theme-card-border: root.theme-card-border;
                theme-focus-border: root.theme-focus-border;
                plugin-toggled(idx) => { root.right-plugin-toggled(idx); }
                plugin-panel-height-changed(idx, h) => {
                    root.right-plugin-panel-height-changed(idx, h);
                }
                plugin-key-input(idx, text, ctrl, meta, alt, shift) => {
                    root.right-plugin-key-input(idx, text, ctrl, meta, alt, shift);
                }
                plugin-scroll(idx, delta) => { root.right-plugin-scroll(idx, delta); }
                plugin-click(idx, x, y) => { root.right-plugin-click(idx, x, y); }
                plugin-focus-changed(idx, focused) => {
                    root.right-plugin-focus-changed(idx, focused);
                }
                plugin-float(idx) => { root.right-plugin-float(idx); }
                // No built-ins in right sidebar
                plugin-reordered(from, to) => { }
                tasku-toggled(exp) => { }
                tasku-command(cmd) => { }
                tasku-key-input(text, ctrl, meta) => { }
                tasku-panel-height-changed(h) => { }
                tasku-scroll(d) => { }
                workspace-selected(code) => { }
                workspace-refresh => { }
                priority-reordered(from, to) => { }
            }
        }

        // ── Bottom bar header (optional, always 52px) ─────────────────────────
        if root.show-bottom-bar: BottomBar {
            width: parent.width;
            height: 52px;
            expanded: root.bottom-bar-expanded;
            theme-card-bg: root.theme-card-bg;
            theme-card-border: root.theme-card-border;
            bottom-right-icon: root.bottom-right-plugin-icon;
            bottom-right-title: root.bottom-right-plugin-title;
            bottom-right-panel-width: root.bottom-right-panel-width;
            expanded-changed(exp) => { root.bottom-bar-expanded = exp; }
        }
    }

    // ── Tasku overlay (top-bar expanded; floats above everything below header) ──
    if root.show-top-bar && root.top-bar-expanded: Rectangle {
        x: 0;
        y: 52px;
        width: parent.width;
        height: parent.height - 52px;
        background: root.theme-window-bg;

        TaskuContent {
            x: 0; y: 0;
            width: parent.width;
            height: parent.height;
            horizontal: true;
            show-resize-handle: false;
            terminal-image: root.tasku-terminal-image;
            tasku-status: root.tasku-status;
            theme-terminal-area-bg: root.theme-terminal-area-bg;
            command(cmd) => { root.tasku-command(cmd); }
            key-input(text, ctrl, meta, alt, shift) => { root.tasku-key-input(text, ctrl, meta, alt, shift); }
            mouse-press(x, y) => { root.tasku-mouse-press(x, y); }
            mouse-move(x, y) => { root.tasku-mouse-move(x, y); }
            mouse-release => { root.tasku-mouse-release(); }
            scroll(delta) => { root.tasku-scroll(delta); }
            resize-start => { }
            resize-move(delta) => { }
            resize-end => { }
        }
    }

    // ── Runner overlay (bottom-bar expanded; floats above the bottom header) ──
    if root.show-bottom-bar && root.bottom-bar-expanded: Rectangle {
        x: 0;
        y: parent.height - root.effective-bottom-bar-h - root.runner-panel-h;
        width: parent.width;
        height: root.runner-panel-h;
        background: root.theme-window-bg;

        // Top border
        Rectangle {
            x: 0; y: 0; width: parent.width; height: 1px;
            background: root.theme-card-border;
        }

        HorizontalLayout {
            x: 0; y: 0;
            width: parent.width;
            height: parent.height;
            spacing: 0; padding: 0;

            RunnerContent {
                horizontal-stretch: 1;
                terminal-image: root.runner-terminal-image;
                theme-terminal-area-bg: root.theme-terminal-area-bg;
                current-command: root.runner-current-command;
                is-running: root.runner-is-running;
                play    => { root.runner-play(); }
                stop    => { root.runner-stop(); }
                restart => { root.runner-restart(); }
                key-input(text, ctrl, meta, alt, shift) => { root.runner-key-input(text, ctrl, meta, alt, shift); }
                scroll(delta) => { root.runner-scroll(delta); }
                mouse-pressed(x, y) => { root.runner-mouse-pressed(x, y); }
                mouse-moved(x, y)   => { root.runner-mouse-moved(x, y); }
                mouse-released()    => { root.runner-mouse-released(); }
            }

            if root.bottom-right-panel-width > 0: Rectangle {
                width: root.bottom-right-panel-width * 1px;
                background: root.theme-window-bg;

                // Left border
                Rectangle {
                    x: 0; y: 0; width: 1px; height: parent.height;
                    background: root.theme-card-border;
                }

                // Terminal area
                br-term := Rectangle {
                    x: 1px; y: 0;
                    width: parent.width - 1px;
                    height: parent.height;
                    background: root.theme-terminal-area-bg;
                    clip: true;

                    br-fs := FocusScope {
                        x: 0; y: 0;
                        width: parent.width; height: parent.height;
                        key-pressed(e) => {
                            root.bottom-right-plugin-key-input(e.text, e.modifiers.control, e.modifiers.meta, e.modifiers.alt, e.modifiers.shift);
                            accept
                        }
                    }

                    if root.bottom-right-plugin-image.width > 0: Image {
                        x: 0; y: 0;
                        width: parent.width; height: parent.height;
                        source: root.bottom-right-plugin-image;
                        image-fit: fill;
                    }
                    if root.bottom-right-plugin-image.width == 0: Text {
                        text: "starting…";
                        color: rgba(255, 255, 255, 0.12);
                        font-size: 11px;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: parent.width; height: parent.height;
                    }

                    TouchArea {
                        width: parent.width; height: parent.height;
                        mouse-cursor: MouseCursor.text;
                        clicked => { br-fs.focus(); }
                        scroll-event(e) => {
                            root.bottom-right-plugin-scroll(e.delta-y / 1px);
                            accept
                        }
                    }
                }
            }
        }

        // ── Resize handle (top 8px — drag upward to grow) ────────────────────
        Rectangle {
            x: 0; y: 0;
            width: parent.width; height: 8px;
            background: transparent;

            runner-resize-ta := TouchArea {
                width: parent.width; height: parent.height;
                mouse-cursor: MouseCursor.ns-resize;

                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.runner-press-abs-y =
                            self.absolute-position.y / 1px + self.mouse-y / 1px;
                        root.runner-press-h = root.runner-panel-h;
                    }
                }
                moved => {
                    if (self.pressed) {
                        // dragging up increases height (overlay grows upward)
                        let delta = self.absolute-position.y / 1px
                                    + self.mouse-y / 1px
                                    - root.runner-press-abs-y;
                        let new-h = (root.runner-press-h / 1px - delta) * 1px;
                        root.runner-panel-h = max(100px, min(new-h, root.height - root.effective-bottom-bar-h - 100px));
                        root.runner-panel-height-changed(root.runner-panel-h / 1px);
                    }
                }
            }

            // Drag pill indicator
            Rectangle {
                x: parent.width / 2 - 20px;
                y: 3px;
                width: 40px; height: 2px;
                border-radius: 1px;
                background: runner-resize-ta.has-hover
                    ? rgba(255, 255, 255, 0.35)
                    : rgba(255, 255, 255, 0.09);
            }
        }
    }

    // ── Left sidebar resize handle ────────────────────────────────────────────
    sidebar-resize := TouchArea {
        x: (root.sidebar-is-resizing
            ? root.resize-press-width
            : root.effective-sidebar-w) * 1px - 4px;
        y: root.effective-top-bar-h;
        width: 8px;
        height: root.height - root.effective-top-bar-h - root.effective-bottom-bar-h;
        visible: !root.sidebar-icon-only;
        mouse-cursor: MouseCursor.ew-resize;

        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.resize-press-abs-x  = self.absolute-position.x / 1px + self.mouse-x / 1px;
                root.resize-press-width  = root.sidebar-width;
                root.sidebar-is-resizing = true;
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                root.sidebar-is-resizing = false;
                root.sidebar-width-changed(root.sidebar-width);
            }
        }

        moved => {
            if (root.sidebar-is-resizing) {
                root.sidebar-width = clamp(
                    root.resize-press-width
                        + (self.absolute-position.x / 1px + self.mouse-x / 1px
                           - root.resize-press-abs-x),
                    80,
                    root.width / 1px - 200
                );
            }
        }
    }

    // ── Right sidebar resize handle ───────────────────────────────────────────
    right-sidebar-resize := TouchArea {
        x: root.width - (root.right-sidebar-is-resizing
            ? root.right-resize-press-width
            : root.effective-right-w) * 1px - 4px;
        y: root.effective-top-bar-h;
        width: 8px;
        height: root.height - root.effective-top-bar-h - root.effective-bottom-bar-h;
        visible: root.show-right-sidebar && !root.right-sidebar-icon-only;
        mouse-cursor: MouseCursor.ew-resize;

        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.right-resize-press-abs-x =
                    self.absolute-position.x / 1px + self.mouse-x / 1px;
                root.right-resize-press-width = root.right-sidebar-width;
                root.right-sidebar-is-resizing = true;
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                root.right-sidebar-is-resizing = false;
                root.right-sidebar-width-changed(root.right-sidebar-width);
            }
        }

        moved => {
            if (root.right-sidebar-is-resizing) {
                // Moving left increases right sidebar width
                root.right-sidebar-width = clamp(
                    root.right-resize-press-width
                        - (self.absolute-position.x / 1px + self.mouse-x / 1px
                           - root.right-resize-press-abs-x),
                    80,
                    root.width / 1px - 200
                );
            }
        }
    }

    // ── Browser panel resize handle ──────────────────────────────────────────
    if root.show-browser-panel && root.browser-panel-width > 0: TouchArea {
        x: root.width
           - root.effective-right-w * 1px
           - (root.show-ai-panel && root.top-right-panel-width > 0 ? root.top-right-panel-width * 1px : 0px)
           - (root.browser-is-resizing ? root.browser-press-width : root.browser-panel-width) * 1px
           - 4px;
        y: root.effective-top-bar-h;
        width: 8px;
        height: root.height - root.effective-top-bar-h - root.effective-bottom-bar-h;
        mouse-cursor: MouseCursor.ew-resize;

        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.browser-press-abs-x = self.absolute-position.x / 1px + self.mouse-x / 1px;
                root.browser-press-width = root.browser-panel-width;
                root.browser-is-resizing = true;
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                root.browser-is-resizing = false;
                root.browser-panel-width-changed(root.browser-panel-width);
            }
        }

        moved => {
            if (root.browser-is-resizing) {
                root.browser-panel-width = clamp(
                    root.browser-press-width
                        - (self.absolute-position.x / 1px + self.mouse-x / 1px
                           - root.browser-press-abs-x),
                    200,
                    root.width / 1px - 400
                );
            }
        }
    }

    // ── Top-right panel resize handle ────────────────────────────────────────
    if root.show-ai-panel && root.top-right-panel-width > 0: TouchArea {
        x: root.width
           - root.effective-right-w * 1px
           - (root.top-right-is-resizing ? root.top-right-press-width : root.top-right-panel-width) * 1px
           - 4px;
        y: root.effective-top-bar-h;
        width: 8px;
        height: root.height - root.effective-top-bar-h - root.effective-bottom-bar-h;
        mouse-cursor: MouseCursor.ew-resize;

        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.top-right-press-abs-x = self.absolute-position.x / 1px + self.mouse-x / 1px;
                root.top-right-press-width = root.top-right-panel-width;
                root.top-right-is-resizing = true;
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                root.top-right-is-resizing = false;
                root.top-right-panel-width-changed(root.top-right-panel-width);
            }
        }

        moved => {
            if (root.top-right-is-resizing) {
                // Moving left increases panel width
                root.top-right-panel-width = clamp(
                    root.top-right-press-width
                        - (self.absolute-position.x / 1px + self.mouse-x / 1px
                           - root.top-right-press-abs-x),
                    200,
                    root.width / 1px - 400
                );
            }
        }
    }

    // ── Help / keybindings overlay ────────────────────────────────────────────
    if root.show-help: HelpOverlay {
        x: 0; y: 0;
        width: parent.width; height: parent.height;
        dismissed => { root.show-help = false; }
    }

    // ── Plugin float overlay ──────────────────────────────────────────────────
    // Shown when the user clicks ↗ on a pixel plugin panel header.
    // Covers the full window with a dim backdrop; the plugin image fills a
    // centered card. Click the backdrop to dismiss.
    if root.float-plugin-image.width > 0: Rectangle {
        x: 0; y: 0;
        width: parent.width; height: parent.height;
        background: rgba(0, 0, 0, 0.72);

        // Dismiss on backdrop click
        TouchArea {
            width: parent.width; height: parent.height;
            clicked => { root.plugin-float-dismissed(); }
        }

        // Centered square card
        card := Rectangle {
            private property <length> card-size: min(800px, min(parent.width - 80px, parent.height - 80px));
            x: (parent.width  - self.card-size) / 2;
            y: (parent.height - self.card-size) / 2;
            width:  self.card-size;
            height: self.card-size;
            background: #0f172a;
            border-radius: 8px;
            clip: true;

            Image {
                x: 0; y: 0;
                width: parent.width; height: parent.height;
                source: root.float-plugin-image;
                image-fit: fill;
            }

            // Eat clicks so they don't propagate to the backdrop dismiss
            TouchArea { width: parent.width; height: parent.height; }
        }
    }
}
